{
  "pathwiseLockdown": "1.4.0",
  "autoMemoryEnabled": false,
  "enableArtifact": false,
  "disableClaudeAiConnectors": true,

  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash",
      "PowerShell",
      "mcp__Claude_Browser",
      "mcp__claude-in-chrome",
      "mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c",
      "mcp__mcp-registry",
      "mcp__ccd_session_mgmt",
      "mcp__ccd_session",
      "mcp__ccd_directory",
      "mcp__ccd_host",
      "mcp__terminal",
      "mcp__scheduled-tasks",
      "SendMessage",
      "ListAgents",
      "RemoteTrigger",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ShareOnboardingGuide",
      "DesignSync",
      "Read(~/AppData/Local/Claude-Data/**)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Write|Edit|NotebookEdit|LSP",
        "hooks": [
          {
            "type": "command",
            "command": "shopt -s nocasematch; input=$(cat); case \"$input\" in *',\"agent_id\":\"'*) ;; *) exit 0 ;; esac; case \"$input\" in *'\"tool_name\":\"Read\"'*) ;; *) echo 'PathWise lockdown: helper agents can only read files.' >&2; exit 2 ;; esac; case \"$input\" in *pathwise_output*|*'~'*) echo 'PathWise lockdown: helper agents cannot read run results.' >&2; exit 2 ;; esac; exit 0",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": []
    }
  }
}
